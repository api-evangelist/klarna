{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Update authorization",
  "title": "Update authorization",
  "properties": {
    "description": {
      "description": "Description of the change.",
      "example": "Added charger",
      "maxLength": 255,
      "minLength": 0,
      "type": "string"
    },
    "order_amount": {
      "description": "The new total order amount. Minor units.",
      "format": "int64",
      "maximum": 200000000,
      "minimum": 0,
      "type": "integer"
    },
    "order_lines": {
      "description": "New set of order lines for the order.",
      "items": {
        "$ref": "#/components/schemas/order_line"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    }
  },
  "required": [
    "order_amount"
  ],
  "type": "object"
}